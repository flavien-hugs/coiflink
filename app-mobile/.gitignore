# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signature APK (#178-signature-borne, ADR-0044) : jamais committer le keystore
# ni ses mots de passe — provisionnés en CI via secrets, générés localement par
# l'utilisateur (voir docs/adr/0044-signature-stable-apk-android.md). Motif large
# (pas seulement le nom exact) : couvre aussi les copies de sauvegarde locales
# (`key.properties.bak`, etc.) qui portent les mêmes secrets.
/android/key.properties*
*.jks
*.keystore
